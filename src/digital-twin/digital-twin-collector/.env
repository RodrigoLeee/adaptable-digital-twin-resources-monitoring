PORT=3001
API_URL=http://localhost:3002
COLLECT_INTERVAL_SECONDS=60
UPLOAD_DIR=./uploads
RESULTS_DIR=./results
NODE_ENV=development

# Modo orientado a eventos (Kafka/Redpanda)
ENABLE_KAFKA=true
KAFKA_BROKERS=localhost:19092
WORKLOAD_TOPIC=workload.events
RECOMMENDATIONS_TOPIC=dt.recommendations
ENABLE_PARQUET_POLLING=false
