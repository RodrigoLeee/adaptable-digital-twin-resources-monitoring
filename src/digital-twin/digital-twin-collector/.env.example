PORT=3001
API_URL=http://localhost:3000
COLLECT_INTERVAL_SECONDS=60
UPLOAD_DIR=./uploads
RESULTS_DIR=./results
NODE_ENV=development

# Modo orientado a eventos (Kafka/Redpanda) — padrão
ENABLE_KAFKA=true
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=digital-twin-collector
KAFKA_GROUP_ID=digital-twin-collector
WORKLOAD_TOPIC=workload.events
RECOMMENDATIONS_TOPIC=dt.recommendations

# Persistir recomendações em ./results/<client_id> (opcional)
SAVE_RESULTS=false

# Modo legado (pull): polling de parquet pós-simulação (opt-in)
ENABLE_PARQUET_POLLING=false
